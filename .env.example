# Spec-RAG environment configuration
# Time to First Token for the LLM in milliseconds
LLM_TTFT_MS=1500

# Default latency to use when predicted latency is unavailable
DEFAULT_PREDICTED_LATENCY_MS=3000.0

# Qdrant search score threshold for cache hits
QDRANT_SCORE_THRESHOLD=0.99

# Simulated sleep durations for speculative and ground truth branches
SPECULATIVE_SLEEP_SEC=1.5
GROUND_TRUTH_SLEEP_SEC=3.0
RECONCILE_SLEEP_SEC=1.05

# L1 cache TTL seconds for in-memory cache
L1_TTL_SECONDS=300

# Default target cache hit rate for benchmark seeding
CACHE_HIT_RATE=0.8

# Default number of benchmark queries
BENCHMARK_QUERY_COUNT=100
